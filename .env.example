# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (use the pooled one on Vercel).
# Vercel's Neon integration sets this for you.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/neondb?sslmode=require

# The single admin password for /admin. Use a long, random passphrase (16+ characters).
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Signs the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
